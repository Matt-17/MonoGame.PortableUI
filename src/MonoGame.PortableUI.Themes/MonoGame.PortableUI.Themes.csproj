<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target: net10.0 (DesktopGL) + net10.0-android, mirroring the core library.
         Clear the inherited singular TargetFramework so the SDK performs the multi-targeting fan-out. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.EndsWith('-android'))">21.0</SupportedOSPlatformVersion>
    <PackageId>MonoGame.PortableUI.Themes</PackageId>
    <Title>MonoGame.PortableUI.Themes</Title>
    <Description>Theme catalog add-on for MonoGame.PortableUI. MonoGame.PortableUI works completely without this package; each theme lives in its own file so it can be copied into a project and customized.</Description>
    <Authors>Matthias Voigt;Marcus Katscher</Authors>
    <Company>code-ix</Company>
    <Product>MonoGame.PortableUI</Product>
    <Version>0.0.0-local</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Matt-17/MonoGame.PortableUI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Condition="!$(TargetFramework.EndsWith('-android'))" />
    <PackageReference Include="MonoGame.Framework.Android" Condition="$(TargetFramework.EndsWith('-android'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoGame.PortableUI\MonoGame.PortableUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Fonts + mgcb snippet for consumers (fonts cannot ship pre-built from NuGet; see ThemeContent/README.md). -->
    <None Include="ThemeContent\**" Pack="true" PackagePath="contentFiles\any\any\ThemeContent\" />
  </ItemGroup>
</Project>
