<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target like the core library. Clear the inherited singular TargetFramework. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.EndsWith('-android'))">21.0</SupportedOSPlatformVersion>
    <PackageId>MonoGame.PortableUI.FontStashSharp</PackageId>
    <Title>MonoGame.PortableUI.FontStashSharp</Title>
    <Description>Optional FontStashSharp font backend for MonoGame.PortableUI: TTF/OTF text rasterized at runtime, at any size and with any character. The core library works without it.</Description>
    <Authors>Matthias Voigt;Marcus Katscher</Authors>
    <Company>code-ix</Company>
    <Product>MonoGame.PortableUI</Product>
    <Version>0.0.0-local</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Matt-17/MonoGame.PortableUI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Condition="!$(TargetFramework.EndsWith('-android'))" />
    <PackageReference Include="MonoGame.Framework.Android" Condition="$(TargetFramework.EndsWith('-android'))" />
    <PackageReference Include="FontStashSharp.MonoGame" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MonoGame.PortableUI\MonoGame.PortableUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
