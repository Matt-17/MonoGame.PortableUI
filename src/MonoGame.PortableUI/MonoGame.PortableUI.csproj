<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target: net10.0 (DesktopGL) + net10.0-android. Clear the singular TargetFramework
         inherited from Directory.Build.props first, otherwise the SDK sees it set and skips the
         multi-targeting fan-out (only the net10.0 inner build would run). -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.EndsWith('-android'))">21.0</SupportedOSPlatformVersion>
    <PackageId>MonoGame.PortableUI</PackageId>
    <Title>MonoGame.PortableUI</Title>
    <Description>A lightweight code-first UI layer for MonoGame.</Description>
    <Authors>Matthias Voigt;Marcus Katscher</Authors>
    <Company>code-ix</Company>
    <Product>MonoGame.PortableUI</Product>
    <Version>0.0.0-local</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Matt-17/MonoGame.PortableUI</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Condition="!$(TargetFramework.EndsWith('-android'))" />
    <PackageReference Include="MonoGame.Framework.Android" Condition="$(TargetFramework.EndsWith('-android'))" />
    <!-- Runtime TTF/OTF fonts (FontStashUIFont). Pure managed; in the core until MonoGame's own
         font system (roadmap: 3.8.8) can back UIFont without an extra dependency. -->
    <PackageReference Include="FontStashSharp.MonoGame" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MonoGame.PortableUI.Benchmarks" />
    <InternalsVisibleTo Include="MonoGame.PortableUI.Tests" />
    <!-- The optional effects package ships in lockstep with the core (same version) and reuses its
         drawing internals (rounded-rect masks, brush texture cache, render-target helpers). -->
    <InternalsVisibleTo Include="MonoGame.PortableUI.Effects" />
  </ItemGroup>
</Project>
