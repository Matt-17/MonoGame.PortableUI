<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Android app: overrides the singular net10.0 TargetFramework inherited from Directory.Build.props. -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>de.codeix.portableui.demo</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <!-- Sample app; not published to NuGet and no XML docs needed. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    APK size (Release APK 12.8 MB -> 4.4 MB, measured with the Pixel 5 build; see docs/android-size.md).
    Profiled AOT stays on: without it the APK is 0.9 MB smaller but cold start ~45 % slower.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Phones only. x86_64 is for emulators on Intel/AMD hosts; Debug builds keep it. An .aab
         ships one ABI per device anyway. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!-- No HTTP in the demo: AndroidMessageHandler would root System.Net.Http, crypto and ASN.1. -->
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
  </PropertyGroup>
  <ItemGroup>
    <!-- Trim FontStashSharp's unused BMFont loader (it pulls in System.Private.Xml). MonoGame.Framework
         stays untrimmed: its content readers are created by reflection. -->
    <TrimmableAssembly Include="Cyotek.Drawing.BitmapFont" />
    <TrimmableAssembly Include="FontStashSharp.Base" />
    <TrimmableAssembly Include="FontStashSharp.MonoGame" />
  </ItemGroup>
  <!-- Native libraries nothing in the demo calls: zlib and Android crypto glue (only needed by the
       HTTP/compression/crypto APIs trimmed away above) and OpenAL (MonoGame audio). An app that plays
       sound, uses HttpClient, DeflateStream or crypto must keep them. -->
  <Target Name="DropUnusedRuntimeNatives" AfterTargets="ResolveRuntimePackAssets">
    <ItemGroup>
      <RuntimePackAsset Remove="@(RuntimePackAsset)" Condition="'%(Filename)' == 'libSystem.IO.Compression.Native' or '%(Filename)' == 'libSystem.Security.Cryptography.Native.Android'" />
    </ItemGroup>
  </Target>
  <Target Name="DropOpenAL" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'libopenal'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MonoGame.PortableUI\MonoGame.PortableUI.csproj" />
    <ProjectReference Include="..\..\src\MonoGame.PortableUI.Themes\MonoGame.PortableUI.Themes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared FontStashSharp demo font: Selawik (SIL OFL), read via TitleContainer from the APK assets. -->
    <Compile Include="..\MonoGame.PortableUI.Demo\DemoFonts.cs" Link="DemoFonts.cs" />
    <AndroidAsset Include="..\MonoGame.PortableUI.Demo\Content\Fonts\Selawik-Regular.ttf" Link="Assets\Content\Fonts\Selawik-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
  </ItemGroup>

  <!--
    MonoGame.Content.Builder.Task derives the mgcb output and intermediate paths from
    $(TargetFramework) alone, without the RID. The per-RID project instances spawned by
    _ComputeFilesToPublishForRuntimeIdentifiers therefore run mgcb concurrently against the
    same directories, and the losing process dies on the shared .mgcontent file. Give each
    RID its own pair of directories so the inner builds cannot collide.
  -->
  <Target Name="IsolateContentBuilderDirsPerRid"
          AfterTargets="CollectContentReferences"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ContentReference>
        <ContentOutputDir>%(ContentReference.ContentOutputDir)/$(RuntimeIdentifier)</ContentOutputDir>
        <ContentIntermediateOutputDir>%(ContentReference.ContentIntermediateOutputDir)/$(RuntimeIdentifier)</ContentIntermediateOutputDir>
      </ContentReference>
    </ItemGroup>
  </Target>
</Project>
